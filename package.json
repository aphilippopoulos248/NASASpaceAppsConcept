{
  "name": "moon-landings-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/ensure-deps.mjs",
    "build": "tsc --noEmit && node scripts/typecheck-server.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run test:science",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "fetch-textures": "node scripts/fetch-textures.mjs",
    "fetch-horizons": "node scripts/fetch-horizons.mjs",
    "check-ephemeris": "node scripts/check-ephemeris.mjs",
    "fetch-terrain": "node scripts/fetch-terrain.mjs",
    "fetch-apollo-terrain": "node scripts/fetch-apollo-terrain.mjs",
    "derive-detail": "node scripts/derive-detail.mjs",
    "build-ice-targets": "python3 -I scripts/build-ice-targets.py",
    "test:science": "node --experimental-strip-types --no-warnings --test tests/iceTargets.test.ts",
    "build-dem": "node --experimental-strip-types --no-warnings scripts/build-dem.mjs",
    "build-heatmap": "node --experimental-strip-types --no-warnings scripts/build-heatmap.mjs",
    "e2e": "node e2e/run.mjs",
    "build-diviner": "node --experimental-strip-types --no-warnings scripts/build-diviner.mjs",
    "build-shadowcam-index": "node --experimental-strip-types --no-warnings scripts/build-shadowcam-index.mjs",
    "fetch-gcat": "node scripts/fetch-gcat-landers.mjs",
    "fetch-site-areas": "node scripts/fetch-site-areas.mjs",
    "build-licences": "node scripts/build-licences.mjs",
    "build-rovers": "node scripts/build-rovers.mjs",
    "build-rover-model": "node scripts/build-rover-model.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "geotiff": "^3.0.5",
    "playwright": "1.60.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
